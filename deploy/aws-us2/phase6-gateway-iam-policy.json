{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SharedState",
      "Effect": "Allow",
      "Action": [
        "dynamodb:DeleteItem",
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:Scan",
        "dynamodb:UpdateItem"
      ],
      "Resource": "arn:aws:dynamodb:REGION:ACCOUNT:table/dali-ai-gateway-aws-us2-state"
    },
    {
      "Sid": "PublishUsage",
      "Effect": "Allow",
      "Action": "sqs:SendMessage",
      "Resource": "arn:aws:sqs:REGION:ACCOUNT:dali-ai-gateway-aws-us2-usage"
    }
  ]
}
