# Reviewed aws-us2 activation generation for Classroom and Dali Chat.
# Copy values into the protected runtime environment; do not commit secrets.
AI_GATEWAY_POLICY_GENERATION_ID=aws-us2-classroom-chat-interprete-v6
AI_GATEWAY_WORKLOAD_GRANTS_JSON={"dali_classroom_server":{"products":["classroom"],"profiles":["classroom.translation.economy","classroom.summary.economy","classroom.transcription.economy","classroom.transcription.live"],"capabilities":["text_generation","audio_transcription","realtime_transcription"]},"dali_chat_server":{"products":["dali_chat"],"profiles":["dali_chat.text.openai","dali_chat.text.openai.gpt-5-6-sol","dali_chat.text.openai.gpt-5-6-terra","dali_chat.text.openai.gpt-5-6-luna","dali_chat.text.gemini","dali_chat.text.ollama","dali_chat.transcription.openai","dali_chat.transcription.gemini","dali_chat.transcription.stream.openai","dali_chat.transcription.stream.gemini","dali_chat.interpret.openai","dali_chat.interpret.gemini","dali_chat.translation.openai","dali_chat.translation.gemini","dali_chat.speech.openai","dali_chat.speech.gemini","dali_chat.image.openai","dali_chat.image.gemini","dali_chat.video.gemini"],"capabilities":["text_generation","audio_transcription","realtime_transcription","realtime_translation","speech_synthesis","image_analysis","video_analysis"]},"interpreter_server_ai":{"enabled":false,"products":["interprete"],"profiles":["interprete.live_summary","interprete.translation.text","interprete.transcription.batch","interprete.transcription.realtime","interprete.translation.realtime","interprete.speech.standard"],"capabilities":["text_generation","audio_transcription","realtime_transcription","realtime_translation","speech_synthesis"]}}
AI_GATEWAY_CALLER_LIMITS_JSON={"dali_classroom_server":1,"dali_chat_server":2,"interpreter_server_ai":2,"interprete":2,"interprete_realtime":1}
AI_GATEWAY_ADMISSION_LEASE_TTL_SECONDS=300
AI_GATEWAY_ADMISSION_DYNAMODB_TABLE=
AI_GATEWAY_ADMISSION_DYNAMODB_REGION=
AI_GATEWAY_SHARED_ADMISSION_REQUIRED=true

# Production circuit state is shared in the same generic DynamoDB state-table
# shape as admission. Blank table/region placeholders intentionally fail closed.
AI_GATEWAY_PROVIDER_CIRCUIT_ENABLED=true
AI_GATEWAY_PROVIDER_CIRCUIT_FAILURE_THRESHOLD=3
AI_GATEWAY_PROVIDER_CIRCUIT_OPEN_SECONDS=30
AI_GATEWAY_PROVIDER_CIRCUIT_DISABLED_ROUTES_JSON=[]
AI_GATEWAY_CIRCUIT_DYNAMODB_TABLE=
AI_GATEWAY_CIRCUIT_DYNAMODB_REGION=
AI_GATEWAY_SHARED_CIRCUIT_REQUIRED=true

# Platform workload-token profile approved for this boundary.
AI_GATEWAY_PLATFORM_WORKLOAD_AUTH_ENABLED=true
AI_GATEWAY_PLATFORM_WORKLOAD_AUTH_REQUIRED_FOR_READINESS=true
AI_GATEWAY_PLATFORM_WORKLOAD_AUDIENCE=dali-ai-gateway
AI_GATEWAY_PLATFORM_WORKLOAD_REQUIRED_SCOPE=ai:execute
AI_GATEWAY_PLATFORM_WORKLOAD_IDS_JSON=["dali_classroom_server","dali_chat_server","interpreter_server_ai"]
AI_GATEWAY_PLATFORM_WORKLOAD_MAX_TOKEN_TTL_SECONDS=300
AI_GATEWAY_PLATFORM_WORKLOAD_CLOCK_SKEW_SECONDS=30
# Operator supplies the stable Platform issuer and HTTPS JWKS endpoint.
AI_GATEWAY_PLATFORM_WORKLOAD_ISSUER=
AI_GATEWAY_PLATFORM_WORKLOAD_JWKS_URL=

# During shadow/cutover, list only workloads that still have a legacy token.
AI_GATEWAY_LEGACY_AUTH_WORKLOAD_IDS_JSON=["dali_classroom_server","dali_chat_server"]
# AI_GATEWAY_SERVICE_TOKENS_JSON is secret and belongs only in the protected env.

# Approved durable sink type: SQS Standard for the aws-us2 deployment. The
# operator supplies its actual AWS region and queue URL together. The
# product-owned relay deduplicates by event_id before account association.
AI_GATEWAY_USAGE_SQS_REGION=
AI_GATEWAY_USAGE_SQS_QUEUE_URL=
AI_GATEWAY_USAGE_DELIVERY_REQUIRED=true
AI_GATEWAY_USAGE_DELIVERY_MAX_ATTEMPTS=3
AI_GATEWAY_USAGE_DELIVERY_RETRY_DELAY_SECONDS=0.25
