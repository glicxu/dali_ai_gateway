[Unit]
Description=Dali Chat narration test API (us3)
After=network-online.target dali-audio-test-gateway.service
Wants=network-online.target

[Service]
User=dali-chat-test
Group=dali-chat-test
WorkingDirectory=/data/dali/test/services/dali-audio-chat/current
EnvironmentFile=/data/dali/test/config/secrets/dali_audio_chat.env
ExecStart=/data/dali/test/services/dali-audio-chat/current/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 15050 --proxy-headers --forwarded-allow-ips 127.0.0.1 --no-access-log
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
MemoryMax=512M
CPUQuota=100%

[Install]
WantedBy=multi-user.target
