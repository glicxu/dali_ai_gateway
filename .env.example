AI_GATEWAY_ENV=development
# Production uses the shared, read-only secret.key_store resolver. Leave this
# empty for local development and use the provider-specific variables below.
AI_GATEWAY_CREDENTIAL_DATABASE_URL=
AI_GATEWAY_CREDENTIAL_SCHEMA=secret
AI_GATEWAY_CREDENTIAL_TABLE=key_store
AI_GATEWAY_OPENAI_CREDENTIAL_ACCESS_ID=openai
AI_GATEWAY_GEMINI_CREDENTIAL_ACCESS_ID=gemini
# A caller value is one token, or ["current","previous"] during rotation.
AI_GATEWAY_SERVICE_TOKENS_JSON={}
AI_GATEWAY_LEGACY_AUTH_WORKLOAD_IDS_JSON=["dali_classroom_server"]
# Platform workload authentication remains disabled until issuer/audience/scope
# and the Platform MS2 workload-token contract are approved.
AI_GATEWAY_PLATFORM_WORKLOAD_AUTH_ENABLED=false
AI_GATEWAY_PLATFORM_WORKLOAD_AUTH_REQUIRED_FOR_READINESS=false
AI_GATEWAY_PLATFORM_WORKLOAD_ISSUER=
AI_GATEWAY_PLATFORM_WORKLOAD_AUDIENCE=
AI_GATEWAY_PLATFORM_WORKLOAD_REQUIRED_SCOPE=
AI_GATEWAY_PLATFORM_WORKLOAD_JWKS_URL=
AI_GATEWAY_PLATFORM_WORKLOAD_IDS_JSON=[]
AI_GATEWAY_PLATFORM_WORKLOAD_MAX_TOKEN_TTL_SECONDS=300
AI_GATEWAY_PLATFORM_WORKLOAD_CLOCK_SKEW_SECONDS=30
AI_GATEWAY_PLATFORM_JWKS_TIMEOUT_SECONDS=3
AI_GATEWAY_PLATFORM_JWKS_REFRESH_INTERVAL_SECONDS=60
AI_GATEWAY_PLATFORM_JWKS_MAX_STALENESS_SECONDS=300
AI_GATEWAY_PLATFORM_JWKS_UNKNOWN_KEY_COOLDOWN_SECONDS=5
# Optional durable content-free SQS Standard sink. Use the instance/task IAM
# role; never place AWS access keys in this file.
AI_GATEWAY_USAGE_SQS_QUEUE_URL=
AI_GATEWAY_USAGE_SQS_REGION=
AI_GATEWAY_USAGE_DELIVERY_MAX_ATTEMPTS=3
AI_GATEWAY_USAGE_DELIVERY_RETRY_DELAY_SECONDS=0.25
# Admission leases are renewed during long-running realtime sessions.
AI_GATEWAY_ADMISSION_LEASE_TTL_SECONDS=300
# Local route circuits are disabled by default until shared-state policy is approved.
AI_GATEWAY_PROVIDER_CIRCUIT_ENABLED=false
AI_GATEWAY_PROVIDER_CIRCUIT_FAILURE_THRESHOLD=3
AI_GATEWAY_PROVIDER_CIRCUIT_OPEN_SECONDS=30
AI_GATEWAY_PROVIDER_CIRCUIT_DISABLED_ROUTES_JSON=[]
AI_GATEWAY_CALLER_LIMITS_JSON={"dali_classroom_server":1,"dali_chat_server":2}
AI_GATEWAY_MODEL_PROFILES_JSON={}
AI_GATEWAY_POLICY_GENERATION_ID=builtin-classroom-v1
# Defaults to the Classroom grants plus a disabled, independently limited
# dali_chat demo grant documented in app/core/config.py.
# Set only as one complete, reviewed JSON generation with MODEL_PROFILES_JSON.
# AI_GATEWAY_WORKLOAD_GRANTS_JSON={...}
AI_GATEWAY_OPENAI_BASE_URL=https://api.openai.com/v1
AI_GATEWAY_OPENAI_API_KEY=
AI_GATEWAY_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
AI_GATEWAY_GEMINI_API_KEY=
AI_GATEWAY_OLLAMA_BASE_URL=http://127.0.0.1:11434
AI_GATEWAY_OLLAMA_ENABLED=false
AI_GATEWAY_REQUEST_TIMEOUT_SECONDS=60
AI_GATEWAY_PROVIDER_PROBE_TIMEOUT_SECONDS=3
AI_GATEWAY_PROVIDER_PROBE_INTERVAL_SECONDS=30
AI_GATEWAY_PROVIDER_PROBE_MAX_STALENESS_SECONDS=90
AI_GATEWAY_PROVIDER_PROBE_MAX_CONCURRENCY=4
AI_GATEWAY_MAX_AUDIO_BYTES=10485760
AI_GATEWAY_MAX_MEDIA_BYTES=20971520
