{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dalifin.com/contracts/ai-gateway/realtime-client-event-v2.schema.json",
  "title": "Dali AI Gateway realtime client event v2",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "request_id", "product", "profile", "target_language"],
      "properties": {
        "type": {"const": "session.start"},
        "request_id": {"type": "string", "format": "uuid"},
        "product": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{1,63}$"},
        "profile": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{2,127}$"},
        "target_language": {"type": "string", "minLength": 2, "maxLength": 35},
        "fallback_profile": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{2,127}$"},
        "compare_profile": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{2,127}$"},
        "policy": {"enum": ["single", "compare", "windowed_failover"], "default": "single"},
        "window_seconds": {"enum": [60, 90, 120], "default": 90},
        "instructions": {"type": "string", "maxLength": 20000},
        "audio_sample_rate_hz": {"enum": [16000, 24000], "default": 24000},
        "outputs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {"enum": ["source_transcript", "target_transcript", "translated_audio"]}
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "sequence", "audio"],
      "properties": {
        "type": {"const": "audio.append"},
        "sequence": {"type": "integer", "minimum": 1},
        "audio": {"type": "string", "minLength": 1, "contentEncoding": "base64"}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {"enum": ["audio.commit", "audio.clear", "session.stop"]}
      }
    }
  ]
}
