{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dalifin.com/contracts/ai-gateway/realtime-server-event-v2.schema.json",
  "title": "Dali AI Gateway realtime server event v2",
  "oneOf": [
    {
      "type": "object", "additionalProperties": false,
      "required": ["type", "session_id", "request_id", "window_id", "lane_id", "profile", "provider_ref", "sequence"],
      "properties": {
        "type": {"const": "session.ready"}, "request_id": {"type": "string", "format": "uuid"},
        "session_id": {"type": "string", "format": "uuid"}, "window_id": {"type": "string"}, "lane_id": {"type": "string"}, "profile": {"type": "string"},
        "sequence": {"type": "integer", "minimum": 0}, "provider_ref": {"type": "string"},
        "max_chunk_bytes": {"type": "integer", "minimum": 1},
        "max_unacknowledged_chunks": {"type": "integer", "minimum": 1},
        "max_unacknowledged_bytes": {"type": "integer", "minimum": 1},
        "max_outbound_events": {"type": "integer", "minimum": 1},
        "audio_sample_rate_hz": {"enum": [16000, 24000]},
        "outputs": {"type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true,
          "items": {"enum": ["source_transcript", "target_transcript", "translated_audio"]}}
      }
    },
    {
      "type": "object", "additionalProperties": false,
      "required": ["type", "session_id", "window_id", "lane_id", "provider_ref", "sequence", "accepted_sequence"],
      "properties": {
        "type": {"const": "audio.accepted"}, "session_id": {"type": "string", "format": "uuid"}, "window_id": {"type": "string"}, "lane_id": {"type": "string"}, "provider_ref": {"type": "string"},
        "sequence": {"type": "integer", "minimum": 0}, "accepted_sequence": {"type": "integer", "minimum": 1}
      }
    },
    {
      "type": "object", "additionalProperties": false,
      "required": ["type", "session_id", "window_id", "lane_id", "provider_ref", "sequence", "text"],
      "properties": {
        "type": {"enum": ["transcript.delta", "transcript.final", "translation.delta", "translation.final"]},
        "session_id": {"type": "string", "format": "uuid"}, "window_id": {"type": "string"}, "lane_id": {"type": "string"}, "provider_ref": {"type": "string"}, "sequence": {"type": "integer", "minimum": 0},
        "text": {"type": "string"}, "item_id": {"type": "string"}
      }
    },
    {
      "type": "object", "additionalProperties": false,
      "required": ["type", "session_id", "window_id", "lane_id", "provider_ref", "sequence", "audio"],
      "properties": {
        "type": {"const": "translation.audio.delta"}, "session_id": {"type": "string", "format": "uuid"}, "window_id": {"type": "string"}, "lane_id": {"type": "string"}, "provider_ref": {"type": "string"},
        "sequence": {"type": "integer", "minimum": 0}, "audio": {"type": "string", "contentEncoding": "base64"},
        "content_type": {"type": "string"}, "sample_rate_hz": {"type": "integer", "minimum": 1},
        "channels": {"type": "integer", "minimum": 1}, "response_id": {"type": "string"},
        "target_language": {"type": "string"}, "sample_format": {"type": "string"}
      }
    },
    {
      "type": "object", "additionalProperties": false,
      "required": ["type", "session_id", "window_id", "lane_id", "provider_ref", "sequence"],
      "properties": {
        "type": {"const": "translation.audio.final"}, "session_id": {"type": "string", "format": "uuid"}, "window_id": {"type": "string"}, "lane_id": {"type": "string"}, "provider_ref": {"type": "string"},
        "sequence": {"type": "integer", "minimum": 0}, "item_id": {"type": "string"},
        "content_type": {"type": "string"}, "sample_rate_hz": {"type": "integer", "minimum": 1},
        "channels": {"type": "integer", "minimum": 1}, "response_id": {"type": "string"},
        "target_language": {"type": "string"}, "sample_format": {"type": "string"},
        "disposition": {"enum": ["complete", "partial", "cancelled", "timed_out", "provider_failed", "ambiguous"]}
      }
    },
    {
      "type": "object", "additionalProperties": false,
      "required": ["type", "session_id", "window_id", "lane_id", "provider_ref", "sequence", "disposition"],
      "properties": {
        "type": {"enum": ["window.closed", "window.failed", "session.closed"]},
        "session_id": {"type": "string", "format": "uuid"}, "window_id": {"type": "string"}, "lane_id": {"type": "string"}, "provider_ref": {"type": "string"}, "sequence": {"type": "integer", "minimum": 0},
        "accepted_sequence": {"type": "integer", "minimum": 0}, "output_sequence": {"type": "integer", "minimum": 0},
        "partial": {"type": "boolean"}, "retryable": {"type": "boolean"},
        "disposition": {"enum": ["complete", "partial", "disconnected", "cancelled", "timed_out", "provider_failed", "slow_consumer", "ambiguous"]},
        "failure_stage": {"enum": ["provider_start", "provider_stream", "provider_output", "client_input", "gateway"]}
      }
    },
    {
      "type": "object", "additionalProperties": false,
      "required": ["type", "session_id", "window_id", "lane_id", "provider_ref", "sequence", "duration_ms", "accepted_input_chunks"],
      "properties": {
        "type": {"const": "usage.final"}, "session_id": {"type": "string", "format": "uuid"}, "window_id": {"type": "string"}, "lane_id": {"type": "string"}, "provider_ref": {"type": "string"},
        "sequence": {"type": "integer", "minimum": 0}, "duration_ms": {"type": "integer", "minimum": 0}, "accepted_input_chunks": {"type": "integer", "minimum": 0},
        "fallback_count": {"type": "integer", "minimum": 0}, "rotation_count": {"type": "integer", "minimum": 0}
      }
    },
    {
      "type": "object", "additionalProperties": false,
      "required": ["type", "session_id", "window_id", "lane_id", "provider_ref", "sequence", "deadline_ms", "accepted_sequence"],
      "properties": {
        "type": {"const": "session.rotation_required"}, "session_id": {"type": "string", "format": "uuid"}, "window_id": {"type": "string"}, "lane_id": {"type": "string"}, "provider_ref": {"type": "string"},
        "sequence": {"type": "integer", "minimum": 0}, "deadline_ms": {"type": "integer", "minimum": 0}, "accepted_sequence": {"type": "integer", "minimum": 0}
      }
    },
    {
      "type": "object", "additionalProperties": false,
      "required": ["type", "session_id", "window_id", "lane_id", "provider_ref", "sequence", "from_provider", "to_provider", "reason"],
      "properties": {
        "type": {"const": "provider.switched"}, "session_id": {"type": "string", "format": "uuid"}, "window_id": {"type": "string"}, "lane_id": {"type": "string"}, "provider_ref": {"type": "string"},
        "sequence": {"type": "integer", "minimum": 0}, "from_provider": {"type": "string"},
        "to_provider": {"type": "string"}, "reason": {"type": "string"},
        "boundary_timestamp_ms": {"type": "integer", "minimum": 0}
      }
    },
    {
      "type": "object", "additionalProperties": false,
      "required": ["type", "error"],
      "properties": {
        "type": {"const": "error"}, "window_id": {"type": "string"}, "sequence": {"type": "integer", "minimum": 0},
        "error": {"type": "object", "additionalProperties": false, "required": ["code", "retryable"], "properties": {"code": {"type": "string"}, "retryable": {"type": "boolean"}, "retry_after_ms": {"type": ["integer", "null"], "minimum": 0}}}
      }
    }
  ]
}
