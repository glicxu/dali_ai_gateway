{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dalifin.com/contracts/ai-gateway/realtime-server-event-v2.schema.json",
  "title": "Dali AI Gateway realtime server event v2",
  "oneOf": [
    {
      "type": "object", "additionalProperties": false,
      "required": ["type", "request_id", "window_id", "profile", "sequence"],
      "properties": {
        "type": {"const": "session.ready"}, "request_id": {"type": "string", "format": "uuid"},
        "window_id": {"type": "string"}, "profile": {"type": "string"},
        "sequence": {"type": "integer", "minimum": 0}, "provider_ref": {"type": "string"}
      }
    },
    {
      "type": "object", "additionalProperties": false,
      "required": ["type", "window_id", "sequence", "accepted_sequence"],
      "properties": {
        "type": {"const": "audio.accepted"}, "window_id": {"type": "string"},
        "sequence": {"type": "integer", "minimum": 0}, "accepted_sequence": {"type": "integer", "minimum": 1}
      }
    },
    {
      "type": "object", "additionalProperties": false,
      "required": ["type", "window_id", "sequence", "text"],
      "properties": {
        "type": {"enum": ["transcript.delta", "transcript.final", "translation.delta", "translation.final"]},
        "window_id": {"type": "string"}, "sequence": {"type": "integer", "minimum": 0},
        "text": {"type": "string"}, "item_id": {"type": "string"}, "lane_id": {"type": "string"}
      }
    },
    {
      "type": "object", "additionalProperties": false,
      "required": ["type", "window_id", "sequence", "audio"],
      "properties": {
        "type": {"const": "translation.audio.delta"}, "window_id": {"type": "string"},
        "sequence": {"type": "integer", "minimum": 0}, "audio": {"type": "string", "contentEncoding": "base64"},
        "content_type": {"type": "string"}, "sample_rate_hz": {"type": "integer", "minimum": 1},
        "channels": {"type": "integer", "minimum": 1}, "lane_id": {"type": "string"}
      }
    },
    {
      "type": "object", "additionalProperties": false,
      "required": ["type", "window_id", "sequence"],
      "properties": {
        "type": {"enum": ["window.closed", "window.failed", "session.closed"]},
        "window_id": {"type": "string"}, "sequence": {"type": "integer", "minimum": 0},
        "accepted_sequence": {"type": "integer", "minimum": 0}, "output_sequence": {"type": "integer", "minimum": 0},
        "partial": {"type": "boolean"}, "retryable": {"type": "boolean"}
      }
    },
    {
      "type": "object", "additionalProperties": false,
      "required": ["type", "window_id", "sequence", "from_provider", "to_provider", "reason"],
      "properties": {
        "type": {"const": "provider.switched"}, "window_id": {"type": "string"},
        "sequence": {"type": "integer", "minimum": 0}, "from_provider": {"type": "string"},
        "to_provider": {"type": "string"}, "reason": {"type": "string"},
        "boundary_timestamp_ms": {"type": "integer", "minimum": 0}
      }
    },
    {
      "type": "object", "additionalProperties": false,
      "required": ["type", "window_id", "sequence", "error"],
      "properties": {
        "type": {"const": "error"}, "window_id": {"type": "string"}, "sequence": {"type": "integer", "minimum": 0},
        "error": {"type": "object", "additionalProperties": false, "required": ["code", "retryable"], "properties": {"code": {"type": "string"}, "retryable": {"type": "boolean"}}}
      }
    }
  ]
}
